# Salin file ini jadi .env lalu isi API key asli. JANGAN commit .env.
# Opencode -> https://opencode.ai/workspace/
# Groq     -> https://console.groq.com/keys
# Gemini   -> https://aistudio.google.com/app/apikey

OPENCODE_API_KEY=your_opencode_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free

GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Model config (CPU-friendly, boleh diubah)
EMBED_MODEL=intfloat/multilingual-e5-small
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=umkm_regulasi

# 9Router (evaluator RAGAS / local LLM fallback)
EVAL_BASE_URL=http://localhost:20128/v1
EVAL_API_KEY=your_eval_key_here
EVAL_MODEL=local-claude
